# ==========================================================
# 环境变量配置模板 (Environment Variables Template)
# 复制此文件为 .env 并填入真实值，切勿将真实凭证提交到 Git
# ==========================================================

# --- 数据库连接 (MySQL 8.0 / TiDB Cloud) ---
# 本地 Docker MySQL 示例 (docker-compose.dev.yml 映射端口 3306):
# DATABASE_URL="mysql://luokai:REPLACE_WITH_MYSQL_PASSWORD@127.0.0.1:3306/luokai_blog"
# 云端 TiDB Cloud 示例 (生产):
# DATABASE_URL="mysql://USER:PASSWORD@gateway01.xxx.tidbcloud.com:4000/DB_NAME?sslaccept=strict"
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/luokai_blog"

# --- Spring Boot 4 后端连接与 Nuxt 渐进代理配置 ---
# 本地开发设置 NUXT_BACKEND_URL="http://127.0.0.1:8080" 即可将 Nuxt SSR 与 /api/** 代理至 Spring Boot；
# 留空则回退至本地 Nitro server/api，便于双栈并行对比。
NUXT_BACKEND_URL="http://127.0.0.1:8080"
SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/luokai_blog"
SPRING_DATASOURCE_USERNAME="luokai"
SPRING_DATASOURCE_PASSWORD=""

# --- JWT 认证密钥（Docker Compose 生产部署必填，前后端共用；不要使用示例值） ---
# 生成命令: openssl rand -base64 48
JWT_SECRET=""

# --- 笔记同步接口（本地脚本与网站服务须配置为相同的随机值） ---
# 生成命令: openssl rand -hex 32
NOTE_SYNC_TOKEN=""
# Nuxt 服务端运行时读取同一个值；Docker Compose 会自动完成该映射。
NUXT_NOTE_SYNC_TOKEN=""
# 本地测试默认无需修改；发布后改为 https://mysgarden.top/api/v1/notes/sync
NOTE_SYNC_URL="http://127.0.0.1:3000/api/v1/notes/sync"
# 可选：图片上传接口；默认在 NOTE_SYNC_URL 后追加 /assets，无需单独配置。
NOTE_SYNC_ASSET_URL=""
# 可选：覆盖笔记源目录，未配置时使用 /run/media/li/Develop/notebook
NOTEBOOK_DIR="/run/media/li/Develop/notebook"
# 图片上传可靠性：默认并发 4、单请求超时 60 秒、每个请求最多尝试 3 次。
# 服务端笔记图片上限为 10 MB；超过此值的本地图片会保留原引用并打印警告，不会上传。
NOTE_SYNC_UPLOAD_CONCURRENCY="4"
NOTE_SYNC_REQUEST_TIMEOUT_MS="60000"
NOTE_SYNC_RETRY_COUNT="3"
NOTE_SYNC_MAX_IMAGE_SIZE_MB="10"
# 本地增量状态（记录 Markdown 与图片 SHA-256）；不要提交该文件。
NOTE_SYNC_STATE_FILE=".cache/notebook-sync-state.json"

# --- Docker Compose MySQL 容器凭证（两项密码必填，使用不同随机值） ---
# 生成命令: openssl rand -hex 32（分别执行两次）
MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="luokai_blog"
MYSQL_USER="luokai"
MYSQL_PASSWORD=""

# --- 站点公开地址 ---
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
PORT=3000
HOST=0.0.0.0

# --- 初始管理员登录凭据 (用于 pnpm db:seed 初始化，绝不硬编码在源码中) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@mysgarden.top"
ADMIN_NICKNAME="lka"

# --- 图片存储驱动 ---
# local：写入 ECS 宿主机挂载的目录；oss：恢复阿里云 OSS 与浏览器签名直传。
STORAGE_DRIVER="local"
# Docker 生产环境固定为 /app/uploads；本地 pnpm dev 留空即可使用 public/uploads。
UPLOAD_DIR=""
# 建议生产环境：https://mysgarden.top/uploads；本地开发可使用 /uploads。
UPLOAD_PUBLIC_BASE_URL="/uploads"

# --- 阿里云 OSS 图片存储（仅 STORAGE_DRIVER=oss 时需要） ---
# Region 使用 OSS 格式，例如 oss-cn-chengdu；生产环境建议配置自定义 CDN 域名。
OSS_REGION="oss-cn-chengdu"
OSS_ENDPOINT="https://oss-cn-chengdu.aliyuncs.com"
OSS_BUCKET="your-bucket-name"
OSS_ACCESS_KEY_ID="your-ram-access-key-id"
OSS_ACCESS_KEY_SECRET="your-ram-access-key-secret"
OSS_PUBLIC_DOMAIN="https://img.mysgarden.top"
# 旧 S3_* 变量仍兼容，但新部署请只使用以上 OSS_* 变量。

# --- OSS 图片迁移（仅 pnpm migrate:images 时使用） ---
# 用逗号列出需迁移的旧图片域名；首次执行不带 --apply 仅预览。
IMAGE_MIGRATION_SOURCE_DOMAINS="https://secret-garden-blog.oss-cn-chengdu.aliyuncs.com,https://img.mysgarden.top"

# --- 异地备份（scripts/backup.sh） ---
# NAS/本地电脑须允许 ECS 通过 SSH 密钥登录；勿把私钥提交到仓库。
BACKUP_SSH_TARGET="backup@nas.example.com"
BACKUP_REMOTE_DIR="/volume1/backups/mystic-garden"
BACKUP_RETENTION_DAYS="30"

# --- Vercel 部署关联 ID (可选) ---
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""
