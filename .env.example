# ==========================================================
# 环境变量配置模板 (Environment Variables Template)
# 复制此文件为 .env 并填入真实值，切勿将真实凭证提交到 Git
# ==========================================================

# --- 数据库连接 (MySQL 8.0 / TiDB Cloud) ---
# 本地 Docker MySQL 示例:
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/luokai_blog"
# 云端 TiDB Cloud 示例 (生产):
# DATABASE_URL="mysql://USER:PASSWORD@gateway01.xxx.tidbcloud.com:4000/DB_NAME?sslaccept=strict"
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/luokai_blog"

# --- JWT 认证密钥 (请替换为足够长的随机字符串) ---
# 生成命令: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-64-char-string"

# --- 站点公开地址 ---
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
PORT=3000
HOST=0.0.0.0

# --- 对象存储 S3 / 阿里云 OSS 直传配置 (可选，留空则回退到本地 public/uploads) ---
S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-access-key-secret"
S3_BUCKET_NAME="your-bucket-name"
S3_PUBLIC_DOMAIN="https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com"
S3_REGION="cn-hangzhou"

# --- Vercel 部署关联 ID (可选) ---
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""